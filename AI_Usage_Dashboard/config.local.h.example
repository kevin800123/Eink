#pragma once

// Keep the first upload in mock mode. These settings are only needed when
// you later want the device status to come from the board and Wi-Fi.
#define AI_DASH_USE_MOCK_DEVICE_STATUS 0
#define AI_DASH_ENABLE_WIFI 1
#define AI_DASH_WIFI_SSID "YOUR_WIFI_SSID"
#define AI_DASH_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Optional overrides:
// #define AI_DASH_REFRESH_INTERVAL_MS (15UL * 60UL * 1000UL)
// #define AI_DASH_EPD_POWER_OFF_AFTER_REFRESH 1
// #define AI_DASH_TIMEZONE "CST-8"

// --- Phase D: real usage from the local collector -------------------------
// Turn this on to replace the mock data with the collector's real figures.
// Requires the Wi-Fi settings above. The collector must be running on your PC
// (tools/collector/run.ps1) and reachable on the LAN. The device holds only
// this collector token, never a provider credential.
//
// #define AI_DASH_USE_HTTP_COLLECTOR 1
// #define AI_DASH_COLLECTOR_HOST "192.168.0.5"   // your PC's LAN IP
// #define AI_DASH_COLLECTOR_PORT 8770
// #define AI_DASH_DEVICE_TOKEN "paste tools/collector/token.local here"

// --- Battery use without USB (deep sleep) ---------------------------------
// Refresh once per wake, then deep-sleep for AI_DASH_REFRESH_INTERVAL_MS,
// drawing microamps. The PC (collector) must be awake when the device wakes.
// If it does not wake on its own, press PWR; it is not bricked.
//
// #define AI_DASH_USE_DEEP_SLEEP 1
// #define AI_DASH_REFRESH_INTERVAL_MS (30UL * 60UL * 1000UL)  // longer = more battery

